{
  "name": "solana-sniper",
  "version": "1.0.0",
  "description": "Autonomous Solana new-token discovery, risk scoring and trading bot, backed by Supabase (zero runtime npm dependencies)",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
