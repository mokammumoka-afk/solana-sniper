# ---- Copy to .env and fill in. NEVER commit .env. ----

# observe = discover + analyze only (no orders, no simulated fills)
# paper   = simulated fills against REAL on-chain curve data (no money moves)
# live    = real transactions (needs PRIVATE_KEY and LIVE_CONFIRM, then "Arm live trading" in the dashboard
#           for THIS session — arming is never saved and never happens automatically)
MODE=paper

# Dashboard access token (>= 12 chars). Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DASHBOARD_TOKEN=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# Use a dedicated RPC provider (Helius/QuickNode/Triton...). The public endpoint is rate-limited.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Supabase (required in every mode — see README "إعداد Supabase" for the full setup) ----
# Project URL, from Supabase dashboard -> Project Settings -> API -> Project URL.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# The service_role secret key (Project Settings -> API -> service_role). This is a DATABASE credential,
# completely separate from the Solana wallet's private key below — it can read/write this project's
# tables (subject to supabase/migrations/0002_security.sql) and nothing else. NEVER use the "anon" key
# here, and never paste the service_role key into the dashboard, a browser, or a public repository.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Solana wallet (dedicated bot wallet only — leave empty for observe/paper) ----
# Base58 64-byte secret key OR a JSON byte array (solana-keygen / Phantom "export private key" format).
PRIVATE_KEY=
# Required for MODE=live (exact text, case-sensitive). This alone does NOT enable live trading — you must
# also click "Arm live trading" in the dashboard and type the same phrase there, every time the bot starts.
LIVE_CONFIRM=

# Optional
PUMPPORTAL_API_KEY=
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
